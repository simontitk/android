<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_graph.xml"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/main_fragment">

    <fragment
        android:id="@+id/main_fragment"
        android:label="Main Fragment"
        android:name="com.example.garbagesorting.MainFragment">
        <action
            android:id="@+id/action_main_to_add"
            app:destination="@id/add_fragment" />
        <action
            android:id="@+id/action_main_to_delete"
            app:destination="@id/delete_fragment" />
    </fragment>

    <fragment
        android:id="@+id/add_fragment"
        android:label="Add Fragment"
        android:name="com.example.garbagesorting.AddFragment" />

    <fragment
        android:id="@+id/delete_fragment"
        android:label="Delete Fragment"
        android:name="com.example.garbagesorting.DeleteFragment" />

</navigation>