<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:text="Delete item" />

    <!-- Input text field to search -->
    <EditText
        android:id="@+id/delete_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/text_container_height"
        android:layout_marginBottom="5dp"
        android:autofillHints="autofill"
        android:background="@color/white"
        android:textColor="@color/black"
        android:hint="Item to remove"
        android:inputType="text" />

    <!-- button that searches -->
    <Button
        android:id="@+id/delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@color/chrome_green"
        android:text="Delete item"
        android:layout_marginBottom="@dimen/activity_horizontal_margin" />


</LinearLayout>